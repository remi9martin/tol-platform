# TOL Platform — environment template.
# Copy to .env and fill in real values locally. Never commit a real .env (see .gitignore).
# All values below are placeholders, not real secrets.

# --- App ---
# NOTE: if `apps/api` fails to start with EACCES (looks like a
# permissions error, isn't one) or an unexpected EADDRINUSE on listen(),
# check Windows' dynamic/excluded TCP port ranges:
#   netsh interface ipv4 show dynamicport tcp
#   netsh interface ipv4 show excludedportrange protocol=tcp
# Ports below are deliberately set above 15000 to sit outside both — the
# reference dev machine's dynamic range was an unusually wide 1024-15000,
# which is where the scope's original 4000/4100 defaults collided.
NODE_ENV=development
PORT=18400
WEB_PORT=18300
WEB_ORIGIN=http://localhost:18300
WORKER_PORT=18500
# Browser-visible — apps/web reads this directly (also needs mirroring
# into apps/web/.env.local; Next.js loads env files relative to its own
# app directory, not the monorepo root — see apps/web/.env.local).
NEXT_PUBLIC_API_URL=http://localhost:18400

# --- Database (packages/db — Prisma/PostgreSQL) ---
DATABASE_URL=postgresql://tol:changeme@localhost:5432/tol_platform

# --- Redis / Queue (apps/worker — BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (evidence uploads; MinIO locally, S3 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tol-evidence
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme

# --- Auth (per the spec: email magic-link + Google OAuth for MVP; MFA for operator/admin) ---
SESSION_SECRET=changeme
GOOGLE_OAUTH_CLIENT_ID=changeme
GOOGLE_OAUTH_CLIENT_SECRET=changeme
MAGIC_LINK_FROM_EMAIL=no-reply@example.com

# --- Mail (local dev via Mailpit) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Lockbox custody (packages/crypto — see ADR-0001/ADR-0009: escrowed/threshold release) ---
# LOCKBOX_KMS_KEY_ID / LOCKBOX_CUSTODY_MODE below are early scaffold
# placeholders for a FUTURE real-KMS/HSM integration — not read by any
# code yet. The four LOCKBOX_KEK_*/LOCKBOX_RECEIPT_HMAC_KEY vars below
# them are what the actual implementation reads (@tol/config's
# getConfig(), consumed via @tol/crypto's parseKeyHex) — this MVP's
# explicit KMS stand-in (see docs/adr/0009-lockbox-crypto.md). Each MUST
# be exactly 64 hex characters (32 bytes). Generate real ones with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOCKBOX_KMS_KEY_ID=changeme
LOCKBOX_CUSTODY_MODE=escrowed_threshold
LOCKBOX_KEK_SEALER=changeme_64_hex_chars_________________________________
LOCKBOX_KEK_OPERATOR=changeme_64_hex_chars_______________________________
LOCKBOX_KEK_ESCROW=changeme_64_hex_chars_________________________________
LOCKBOX_RECEIPT_HMAC_KEY=changeme_64_hex_chars___________________________

# --- Observability ---
LOG_LEVEL=info
