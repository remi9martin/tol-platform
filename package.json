{
  "name": "tol-platform",
  "version": "0.0.0",
  "private": true,
  "description": "TOL / Trust Online — institutional marketplace platform. Canonical pnpm monorepo per the build spec.",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
